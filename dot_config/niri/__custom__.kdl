// 聚焦窗口时显示明显边框，颜色由 noctalia 动态生成（noctalia.kdl 中的 primary，高对比）
// Visible border on focused window; color comes from noctalia's palette (see noctalia.kdl)
layout {
    focus-ring {
        on
        width 3
    }
}

cursor {
    // xcursor-theme "breeze_cursors"
    xcursor-theme "Adwaita"
    xcursor-size 48
}

binds {
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%-"; }
    // 锁定屏幕 (使用 Noctalia 原生锁屏) / Lock screen using Noctalia native lockscreen
    Mod+Shift+L { spawn "noctalia" "msg" "session" "lock"; }

    // 用 Emacs 编辑当前输入框 / Edit text with Emacs everywhere
    Mod+Shift+X { spawn "emacsclient" "-a" "" "--eval" "(emacs-everywhere)"; }
    // 左手单手焦点控制 / One-handed Left-hand Focus Controls
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
 
    // 截取整个显示器屏幕 / Fullscreen screenshot
    Mod+Shift+Z  { screenshot-screen; }

    // 截取当前活动窗口 / Active window screenshot
    Mod+Shift+C   { screenshot-window; }

}

// emacs-everywhere 弹出的小编辑框浮动显示
window-rule {
    match title="Emacs Everywhere ::*"
    open-floating true
}
// ==========================================
// Scratchpad 终端 (Super+G toggle)
// ==========================================
window-rule {
    match app-id=r"^scratchpad$"
    open-floating true

    // ── 位置配置 ──
    // 取消注释你想要的位置，同时注释掉其他选项。
    // 如果选择正中央，请注释掉所有 default-floating-position 行。
    //
    // 上排：
    default-floating-position x=0 y=40 relative-to="top"          // ← 当前：中上方
    // default-floating-position x=40 y=40 relative-to="top-left"  // 左上方
    // default-floating-position x=40 y=40 relative-to="top-right" // 右上方
    //
    // 中排：
    // default-floating-position x=0 y=0 relative-to="left"        // 左中
    // (注释掉所有 default-floating-position 行 = 正中央)
    // default-floating-position x=0 y=0 relative-to="right"       // 右中
    //
    // 下排：
    // default-floating-position x=40 y=40 relative-to="bottom-left"   // 左下方
    // default-floating-position x=0 y=40 relative-to="bottom"         // 中下方
    // default-floating-position x=40 y=40 relative-to="bottom-right"  // 右下方

    // ── 尺寸配置 ──
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.6; }
}
