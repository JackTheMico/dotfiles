{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "/home/jackwy/.agents/ponytail/.opencode/plugins/ponytail.mjs",
    "@mem0/opencode-plugin"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/jackwy/.local/bin/codebase-memory-mcp"
      ]
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
